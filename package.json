{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:netlify": "vite build --mode production && node -e \"import('./build-config.js').then(m => m.copyAdditionalFiles(m.buildConfig.netlify))\"",
    "build:lws": "vite build --mode lws && node build-lws.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "clean": "node clean-cache.js",
    "dev:clean": "npm run clean && npm run dev",
    "postbuild": "node -e \"console.log('Build completed successfully!')\""
  },
  "dependencies": {
    "@feexpay/react-sdk": "^1.5.8",
    "@heroicons/react": "^2.2.0",
    "@react-three/drei": "9.105.5",
    "@react-three/fiber": "8.15.19",
    "@supabase/supabase-js": "^2.58.0",
    "framer-motion": "12.23.12",
    "lucide-react": "^0.417.0",
    "node-fetch": "^3.3.2",
    "onesignal-ngx": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-parallax-tilt": "1.7.308",
    "react-router-dom": "^7.8.2",
    "three": "0.159.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "terser": "^5.44.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  }
}
